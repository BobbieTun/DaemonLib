            local min, max, inc = cfg.Min or 0, cfg.Max or 100, cfg.Increment or 1
            local value = cfg.Default or min
            local dragging = false

            local function update(input)
                local pos = math.clamp((input.Position.X - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
                value = math.floor((min + (max - min) * pos) / inc + 0.5) * inc
                value = math.clamp(value, min, max)
                local scale = (value - min) / (max - min)
                Tween(barFill, {Size = UDim2.new(scale,0,1,0)}, 0.05)
                Tween(knob, {Position = UDim2.new(scale,-7,0.5,-7)}, 0.05)
                valueLabel.Text = tostring(value) .. (cfg.Suffix or "")
                if cfg.Callback then cfg.Callback(value) end
            end

            local scale0 = (value - min) / (max - min)
            barFill.Size = UDim2.new(scale0, 0, 1, 0)
            knob.Position = UDim2.new(scale0, -7, 0.5, -7)

            barBg.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true update(input) end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then update(input) end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
            end)

            return {Instance = base, Get = function() return value end, Set = function(v)
                value = math.clamp(v, min, max)
                local s = (value - min) / (max - min)
                barFill.Size = UDim2.new(s, 0, 1, 0)
                knob.Position = UDim2.new(s, -7, 0.5, -7)
                valueLabel.Text = tostring(value) .. (cfg.Suffix or "")
                if cfg.Callback then cfg.Callback(value) end
            end}
        end

