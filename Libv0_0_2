                    BindBtn.Text = "..."
                    Library:Tween(bindStroke, {Color = Library.Theme.Accent}, 0.2)

                    local conn
                    conn = InputService.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            if input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Delete then
                                Bind.Value = nil
                                BindBtn.Text = "None"
                            else
                                Bind.Value = input.KeyCode
                                BindBtn.Text = input.KeyCode.Name
                            end
                            Listening = false
                            conn:Disconnect()
                            Library:Tween(bindStroke, {Color = Library.Theme.Border}, 0.2)
                            Library.Flags[Config.Flag or Config.Name] = Bind.Value
                            if Config.Callback then
                                local ok, err = pcall(Config.Callback, Bind.Value)
                                if not ok then warn("DaemonIX Keybind Error: " .. tostring(err)) end
                            end
                        end
                    end)
                end)

                -- Mode Menu
                local MenuOpen = false
                local ModeMenu = Library:Create("Frame", {
                    Parent = Library.ScreenGui,
                    Size = UDim2.new(0, 110, 0, 96),
                    BackgroundColor3 = Library.Theme.Surface,
                    BorderSizePixel = 0,
                    Visible = false,
                    ZIndex = 200,
                })
                Library:Create("UICorner", {Parent = ModeMenu, CornerRadius = UDim.new(0, 10)})
                Library:Create("UIStroke", {
                    Parent = ModeMenu,
                    Color = Library.Theme.Border,
                    Thickness = 1,
                })

                local Modes = {"Toggle", "Hold", "Always"}
                for i, m in pairs(Modes) do
                    local MBtn = Library:Create("TextButton", {
                        Parent = ModeMenu,
                        Size = UDim2.new(1, 0, 0, 32),
                        Position = UDim2.new(0, 0, 0, (i-1)*32),
                        BackgroundTransparency = 1,
                        Text = m,
                        TextColor3 = Library.Theme.Text,
                        Font = Enum.Font.Gotham,
                        TextSize = 12,
                        ZIndex = 201,
                    })
                    MBtn.MouseEnter:Connect(function()
                        MBtn.BackgroundTransparency = 0.9
                        MBtn.BackgroundColor3 = Library.Theme.SurfaceLight
                    end)
                    MBtn.MouseLeave:Connect(function()
                        MBtn.BackgroundTransparency = 1
                    end)
                    MBtn.MouseButton1Click:Connect(function()
                        Bind.Mode = m
                        MenuOpen = false
                        Library:ClosePopup(ModeMenu)
                        Library:Notify("Keybind", "Mode set to: " .. m, 2)
                    end)
                end

                BindBtn.MouseButton2Click:Connect(function()
                    MenuOpen = not MenuOpen
                    if MenuOpen then
                        local abs = BindBtn.AbsolutePosition
                        local size = BindBtn.AbsoluteSize
                        ModeMenu.Position = UDim2.new(0, abs.X, 0, abs.Y + size.Y + 4)
                        Library:RegisterPopup(ModeMenu, function() MenuOpen = false end)
                    else
                        Library:ClosePopup(ModeMenu)
                    end
                end)

                table.insert(Library.Toggles, Bind)

                function Bind:SetKey(k)
                    Bind.Value = k
                    BindBtn.Text = k and k.Name or "None"
                    Library.Flags[Config.Flag or Config.Name] = k
                end

                return Bind
            end

            function Section:ColorPicker(Config)
                Config = Config or {}
                Config.Default = Config.Default or Color3.fromRGB(255, 255, 255)

                local ColorPicker = {
                    Value = Config.Default,
                    Transparency = (Config.Transparency ~= nil and Config.Transparency) or 0,
                    Type = "ColorPicker",
                    Title = Config.Name or "Color",
                    Callback = Config.Callback or function() end,
                    Rainbow = false,
                    Hue = 0, Sat = 1, Vib = 1,
                }

                local function SetHSVFromRGB(color)
                    local h, s, v = Color3.toHSV(color)
                    ColorPicker.Hue, ColorPicker.Sat, ColorPicker.Vib = h, s, v
                end
                SetHSVFromRGB(ColorPicker.Value)

                local Line = Library:Create("Frame", {
                    Parent = Container,
                    Size = UDim2.new(1, -28, 0, 42),
                    Position = UDim2.new(0, 14, 0, 0),
                    BackgroundTransparency = 1,
                })

                Library:Create("TextLabel", {
                    Parent = Line,
                    Text = Config.Name or "Color",
                    Size = UDim2.new(1, -60, 1, 0),
                    BackgroundTransparency = 1,
                    Font = Enum.Font.Gotham,
                    TextSize = 13,
                    TextColor3 = Library.Theme.Text,
                    TextXAlignment = Enum.TextXAlignment.Left,
                })

                local DisplayFrame = Library:Create("TextButton", {
                    Parent = Line,
                    Size = UDim2.new(0, 48, 0, 26),
                    Position = UDim2.new(1, -58, 0.5, -13),
                    BackgroundColor3 = ColorPicker.Value,
                    BackgroundTransparency = ColorPicker.Transparency,
                    AutoButtonColor = false,
                    Text = "",
                })
                Library:Create("UICorner", {Parent = DisplayFrame, CornerRadius = UDim.new(0, 6)})
                Library:Create("UIStroke", {
                    Parent = DisplayFrame,
                    Color = Library.Theme.Border,
                    Thickness = 1,
                })

                if Config.Transparency ~= nil then
                    local Checker = Library:Create("ImageLabel", {
                        Parent = DisplayFrame,
                        Size = UDim2.new(1, 0, 1, 0),
                        BackgroundTransparency = 1,
                        Image = "rbxassetid://12977615774",
                        ScaleType = Enum.ScaleType.Tile,
                        TileSize = UDim2.new(0, 10, 0, 10),
                        ZIndex = DisplayFrame.ZIndex - 1,
                    })
                    Library:Create("UICorner", {Parent = Checker, CornerRadius = UDim.new(0, 6)})
                end

                -- Popup
                local Popup = Library:Create("Frame", {
                    Name = "ColorPickerPopup",
                    Parent = Library.ScreenGui,
                    BackgroundColor3 = Library.Theme.Surface,
                    BorderSizePixel = 0,
                    Size = UDim2.fromOffset(250, (Config.Transparency ~= nil) and 300 or 280),
                    Visible = false,
                    ZIndex = 5000,
                })
                Library:Create("UICorner", {Parent = Popup, CornerRadius = UDim.new(0, 12)})
                Library:Create("UIStroke", {
                    Parent = Popup,
                    Color = Library.Theme.Border,
                    Thickness = 1,
                })

                local Inner = Library:Create("Frame", {
                    Parent = Popup,
                    Size = UDim2.new(1, -16, 1, -16),
                    Position = UDim2.new(0, 8, 0, 8),
                    BackgroundTransparency = 1,
                    ZIndex = 5001,
                })

                -- Sat/Vib Map
                local SatVib = Library:Create("ImageButton", {
                    Parent = Inner,
                    Size = UDim2.fromOffset(220, 220),
                    Position = UDim2.fromOffset(0, 0),
                    Image = "rbxassetid://4155801252",
                    AutoButtonColor = false,
                    BorderSizePixel = 0,
                    ZIndex = 5002,
                })
                Library:Create("UICorner", {Parent = SatVib, CornerRadius = UDim.new(0, 8)})

                local Cursor = Library:Create("Frame", {
                    Parent = SatVib,
                    Size = UDim2.fromOffset(14, 14),
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    BorderSizePixel = 2,
                    BorderColor3 = Color3.new(0, 0, 0),
                    ZIndex = 5003,
                })
                Library:Create("UICorner", {Parent = Cursor, CornerRadius = UDim.new(1, 0)})

                -- Hue Bar
                local HueBar = Library:Create("ImageButton", {
                    Parent = Inner,
                    Size = UDim2.fromOffset(20, 220),
                    Position = UDim2.new(1, -20, 0, 0),
                    AutoButtonColor = false,
                    BorderSizePixel = 0,
                    ZIndex = 5002,
                })

                local HueGrad = Library:Create("Frame", {
                    Parent = HueBar,
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    ZIndex = 5002,
                })
                Library:Create("UICorner", {Parent = HueGrad, CornerRadius = UDim.new(0, 6)})

                -- FIX: Integer steps guarantee time=1.0 exactly
                local seq = {}
                for i = 0, 20 do
                    local t = i / 20
                    table.insert(seq, ColorSequenceKeypoint.new(t, Color3.fromHSV(t, 1, 1)))
                end
                Library:Create("UIGradient", {
                    Parent = HueGrad,
                    Color = ColorSequence.new(seq),
                    Rotation = 90,
                })

                local HueCursor = Library:Create("Frame", {
                    Parent = HueBar,
                    Size = UDim2.new(1, 4, 0, 3),
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.new(0.5, 0, 0, 0),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    BorderColor3 = Color3.new(0, 0, 0),
                    BorderSizePixel = 1,
                    ZIndex = 5003,
                })

                -- Inputs
                local InputRow = Library:Create("Frame", {
                    Parent = Inner,
                    Size = UDim2.new(1, 0, 0, 26),
                    Position = UDim2.fromOffset(0, 228),
                    BackgroundTransparency = 1,
                    ZIndex = 5002,
                })

                local HexBox = Library:Create("TextBox", {
                    Parent = InputRow,
                    Size = UDim2.new(0.4, -4, 1, 0),
                    BackgroundColor3 = Library.Theme.SurfaceLight,
                    Text = "#FFFFFF",
                    TextColor3 = Library.Theme.Text,
                    Font = Enum.Font.Gotham,
                    TextSize = 12,
                    ClearTextOnFocus = false,
                    ZIndex = 5003,
                })
                Library:Create("UICorner", {Parent = HexBox, CornerRadius = UDim.new(0, 4)})
                Library:Create("UIStroke", {
                    Parent = HexBox,
                    Color = Library.Theme.Border,
                    Thickness = 1,
                })

                local RgbBox = Library:Create("TextBox", {
                    Parent = InputRow,
                    Size = UDim2.new(0.6, -4, 1, 0),
                    Position = UDim2.new(0.4, 4, 0, 0),
                    BackgroundColor3 = Library.Theme.SurfaceLight,
                    Text = "255, 255, 255",
                    TextColor3 = Library.Theme.Text,
                    Font = Enum.Font.Gotham,
                    TextSize = 12,
                    ClearTextOnFocus = false,
                    ZIndex = 5003,
                })
                Library:Create("UICorner", {Parent = RgbBox, CornerRadius = UDim.new(0, 4)})
                Library:Create("UIStroke", {
                    Parent = RgbBox,
                    Color = Library.Theme.Border,
                    Thickness = 1,
                })

                -- Transparency
                local TransparencyBar, TransCursor
                if Config.Transparency ~= nil then
                    TransparencyBar = Library:Create("ImageButton", {
                        Parent = Inner,
                        Size = UDim2.new(1, 0, 0, 14),
                        Position = UDim2.fromOffset(0, 258),
                        Image = "rbxassetid://12978095818",
                        AutoButtonColor = false,
                        BorderSizePixel = 0,
                        ZIndex = 5002,
                    })
                    Library:Create("UICorner", {Parent = TransparencyBar, CornerRadius = UDim.new(0, 4)})

                    TransCursor = Library:Create("Frame", {
                        Parent = TransparencyBar,
                        Size = UDim2.new(0, 3, 1, 0),
                        BackgroundColor3 = Color3.new(1, 1, 1),
                        BorderColor3 = Color3.new(0, 0, 0),
                        BorderSizePixel = 1,
                        ZIndex = 5003,
                    })
                end

                local function ClampToViewport(px, py, sx, sy)
                    local vp = Camera.ViewportSize
                    px = math.clamp(px, 8, vp.X - sx - 8)
                    py = math.clamp(py, 8, vp.Y - sy - 8)
                    return px, py
                end

                local function UpdatePopupPos(force)
                    if not Popup.Visible and not force then return end
                    local sx, sy = Popup.AbsoluteSize.X, Popup.AbsoluteSize.Y
                    local px = DisplayFrame.AbsolutePosition.X - sx + DisplayFrame.AbsoluteSize.X + 10
                    local py = DisplayFrame.AbsolutePosition.Y
                    px, py = ClampToViewport(px, py, sx, sy)
                    Popup.Position = UDim2.fromOffset(px, py)
                end

                function ColorPicker:Display()
                    ColorPicker.Value = Color3.fromHSV(ColorPicker.Hue, ColorPicker.Sat, ColorPicker.Vib)

                    DisplayFrame.BackgroundColor3 = ColorPicker.Value
                    DisplayFrame.BackgroundTransparency = (Config.Transparency ~= nil) and ColorPicker.Transparency or 0

                    SatVib.ImageColor3 = Color3.fromHSV(ColorPicker.Hue, 1, 1)
                    Cursor.Position = UDim2.new(ColorPicker.Sat, 0, 1 - ColorPicker.Vib, 0)
                    HueCursor.Position = UDim2.new(0.5, 0, ColorPicker.Hue, 0)

                    HexBox.Text = "#" .. ColorPicker.Value:ToHex()
                    RgbBox.Text = string.format("%d, %d, %d",
                        math.floor(ColorPicker.Value.R * 255),
                        math.floor(ColorPicker.Value.G * 255),
                        math.floor(ColorPicker.Value.B * 255))

                    if TransparencyBar then
                        TransparencyBar.ImageColor3 = ColorPicker.Value
                        TransCursor.Position = UDim2.new(1 - ColorPicker.Transparency, 0, 0, 0)
                    end

                    local flagName = Config.Flag or Config.Name
                    if Config.Transparency ~= nil then
                        Library.Flags[flagName] = {Color = ColorPicker.Value, Transparency = ColorPicker.Transparency}
                    else
                        Library.Flags[flagName] = ColorPicker.Value
                    end

                    local ok, err = pcall(ColorPicker.Callback, ColorPicker.Value, ColorPicker.Transparency)
                    if not ok then warn("DaemonIX ColorPicker Error: " .. tostring(err)) end
                end

                local draggingHue, draggingSat, draggingTrans = false, false, false

                local function UpdateHue(input)
                    local y = math.clamp(input.Position.Y - HueBar.AbsolutePosition.Y, 0, HueBar.AbsoluteSize.Y)
                    ColorPicker.Hue = y / HueBar.AbsoluteSize.Y
                    ColorPicker:Display()
                end
                local function UpdateSatVib(input)
                    local x = math.clamp(input.Position.X - SatVib.AbsolutePosition.X, 0, SatVib.AbsoluteSize.X)
                    local y = math.clamp(input.Position.Y - SatVib.AbsolutePosition.Y, 0, SatVib.AbsoluteSize.Y)
                    ColorPicker.Sat = x / SatVib.AbsoluteSize.X
                    ColorPicker.Vib = 1 - (y / SatVib.AbsoluteSize.Y)
                    ColorPicker:Display()
                end
                local function UpdateTrans(input)
                    if not TransparencyBar then return end
                    local x = math.clamp(input.Position.X - TransparencyBar.AbsolutePosition.X, 0, TransparencyBar.AbsoluteSize.X)
                    ColorPicker.Transparency = 1 - (x / TransparencyBar.AbsoluteSize.X)
                    ColorPicker:Display()
                end

                HueBar.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        draggingHue = true
                        UpdateHue(input)
                    end
                end)
                SatVib.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        draggingSat = true
                        UpdateSatVib(input)
                    end
                end)
                if TransparencyBar then
                    TransparencyBar.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            draggingTrans = true
                            UpdateTrans(input)
                        end
                    end)
                end

                Library:Connect(InputService.InputChanged, function(input)
                    local t = input.UserInputType
                    if t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch then
                        if draggingHue then UpdateHue(input) end
                        if draggingSat then UpdateSatVib(input) end
                        if draggingTrans then UpdateTrans(input) end
                    end
                end)

                Library:Connect(InputService.InputEnded, function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        draggingHue, draggingSat, draggingTrans = false, false, false
                    end
                end)

                DisplayFrame.MouseButton1Click:Connect(function()
                    if Popup.Visible then
                        Library:ClosePopup(Popup)
                    else
                        Library:RegisterPopup(Popup, nil)
                        UpdatePopupPos(true)
                    end
                end)

                DisplayFrame.MouseButton2Click:Connect(function()
                    ColorPicker.Rainbow = not ColorPicker.Rainbow
                    Library:Notify("Rainbow Mode", "Toggled: " .. tostring(ColorPicker.Rainbow), 2)
                end)

                Library:Connect(RunService.RenderStepped, function()
                    if Popup and Popup.Parent and Popup.Visible then
                        UpdatePopupPos()
                    end
                end)

                task.spawn(function()
                    while Popup and Popup.Parent do
                        if ColorPicker.Rainbow then
                            ColorPicker.Hue = (tick() % 5) / 5
                            ColorPicker:Display()
                        end
                        task.wait()
                    end
                end)

                HexBox.FocusLost:Connect(function()
                    local txt = HexBox.Text:gsub("#", "")
                    if #txt == 6 then
                        local ok, col = pcall(Color3.fromHex, txt)
                        if ok and col then
                            SetHSVFromRGB(col)
                            ColorPicker:Display()
                        end
                    end
                end)

                RgbBox.FocusLost:Connect(function()
                    local r, g, b = RgbBox.Text:match("(%d+)%s*,%s*(%d+)%s*,%s*(%d+)")
                    r, g, b = tonumber(r), tonumber(g), tonumber(b)
                    if r and g and b then
                        r = math.clamp(r, 0, 255)
                        g = math.clamp(g, 0, 255)
                        b = math.clamp(b, 0, 255)
                        SetHSVFromRGB(Color3.fromRGB(r, g, b))
                        ColorPicker:Display()
                    end
                end)

                ColorPicker:Display()
                return ColorPicker
            end

            return Section
        end

        return Tab
    end

    --// Global Input Handlers
    self:Connect(InputService.InputBegan, function(input, processed)
        if input.KeyCode == self.Keybind and not processed then
            self.IsVisible = not self.IsVisible
            if self.ScreenGui then
                self.ScreenGui.Enabled = self.IsVisible
            end
        end
    end)

    self:Connect(InputService.InputBegan, function(input, processed)
        if processed then return end
        for _, bind in pairs(self.Toggles) do
            if bind.Value and input.KeyCode == bind.Value then
                if bind.Mode == "Toggle" then
                    bind.State = not bind.State
                    if bind.Callback then pcall(bind.Callback, bind.State) end
                elseif bind.Mode == "Hold" then
                    bind.State = true
                    if bind.Callback then pcall(bind.Callback, true) end
                end
            end
        end
    end)

    self:Connect(InputService.InputEnded, function(input)
        for _, bind in pairs(self.Toggles) do
            if bind.Value and bind.Mode == "Hold" and input.KeyCode == bind.Value then
                bind.State = false
                if bind.Callback then pcall(bind.Callback, false) end
            end
        end
    end)

    -- Outside-click popup closer
    self:Connect(InputService.InputBegan, function(input, processed)
        if processed then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local pos = input.Position
        local toClose = {}
        for popup, cb in pairs(self.ActivePopups) do
            if popup.Visible and popup.Parent then
                local absPos = popup.AbsolutePosition
                local absSize = popup.AbsoluteSize
                if pos.X < absPos.X or pos.X > absPos.X + absSize.X or
                   pos.Y < absPos.Y or pos.Y > absPos.Y + absSize.Y then
                    table.insert(toClose, popup)
                end
            end
        end
        for _, popup in ipairs(toClose) do
            self:ClosePopup(popup)
        end
    end)

    self:Connect(InputService.InputBegan, function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.Escape then
            self:CloseAllPopups()
        end
    end)

    --// Config System
    function Library:SaveConfig(name)
        local ok = pcall(function()
            if not isfolder(self.Directory) then makefolder(self.Directory) end
        end)
        if not ok then
            self:Notify("Config Error", "Cannot access filesystem", 3)
            return
        end

        local sanitized = {}
        for k, v in pairs(self.Flags) do
            if typeof(v) == "Color3" then
                sanitized[k] = {__Type = "Color3", R = v.R, G = v.G, B = v.B}
            elseif typeof(v) == "EnumItem" then
                sanitized[k] = {__Type = "Enum", Class = tostring(v.EnumType), Value = v.Name}
            elseif typeof(v) == "table" and v.Color and typeof(v.Color) == "Color3" then
                sanitized[k] = {
                    __Type = "ColorTrans",
                    R = v.Color.R, G = v.Color.G, B = v.Color.B,
                    Transparency = v.Transparency
                }
            else
                sanitized[k] = v
            end
        end

        writefile(self.Directory .. "/" .. name .. ".json", HttpService:JSONEncode(sanitized))
        self:Notify("Config", "Saved config: " .. name, 3)
    end

    function Library:LoadConfig(name)
        local ok, exists = pcall(function()
            return isfile(self.Directory .. "/" .. name .. ".json")
        end)
        if not ok or not exists then
            self:Notify("Config Error", "Config not found: " .. name, 3)
            return
        end

        local data = HttpService:JSONDecode(readfile(self.Directory .. "/" .. name .. ".json"))
        for k, v in pairs(data) do
            if type(v) == "table" and v.__Type then
                if v.__Type == "Color3" then
                    self.Flags[k] = Color3.new(v.R, v.G, v.B)
                elseif v.__Type == "Enum" then
                    local et = Enum[v.Class]
                    if et then self.Flags[k] = et[v.Value] end
                elseif v.__Type == "ColorTrans" then
                    self.Flags[k] = {Color = Color3.new(v.R, v.G, v.B), Transparency = v.Transparency}
                end
            else
                self.Flags[k] = v
            end
        end
        self:Notify("Config", "Loaded config: " .. name, 3)
    end

    function Library:Unload()
        self:DisconnectAll()
        if self.ScreenGui then self.ScreenGui:Destroy() end
        self.ScreenGui = nil
        self.NotifContainer = nil
    end

    return self
end

getgenv().Library = Library
return Library
