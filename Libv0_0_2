--// Core Utilities
function Library:Create(class, props)
    local obj = Instance.new(class)
    for k, v in pairs(props) do
        if k ~= "Parent" then obj[k] = v end
    end
    if props.Parent then obj.Parent = props.Parent end
    return obj
end

function Library:Tween(obj, props, time, style, dir)
    local info = TweenInfo.new(time or 0.3, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out)
    local tween = TweenService:Create(obj, info, props)
    tween:Play()
    return tween
end

function Library:Connect(signal, callback)
    local conn = signal:Connect(callback)
    table.insert(self.Connections, conn)
    return conn
end

function Library:DisconnectAll()
    for _, conn in ipairs(self.Connections) do
        if conn then pcall(function() conn:Disconnect() end) end
    end
    self.Connections = {}
end

function Library:GetTextSize(text, font, size, maxWidth)
    return TextService:GetTextSize(text, size, font, Vector2.new(maxWidth or math.huge, math.huge))
end

function Library:UpdateScale()
    local vp = Camera.ViewportSize
    if vp.X < 900 or vp.Y < 600 then
        self.IsMobile = true
        self.Scale = math.clamp(math.min(vp.X / 800, vp.Y / 500), 0.55, 1.15)
    else
        self.IsMobile = false
        self.Scale = 1
    end
end

--// Popup Manager
function Library:RegisterPopup(frame, closeCallback)
    for popup, cb in pairs(self.ActivePopups) do
        if popup ~= frame and popup.Parent then
            popup.Visible = false
            if cb then cb() end
        end
    end
    self.ActivePopups[frame] = closeCallback
    frame.Visible = true
end

function Library:ClosePopup(frame)
    self.ActivePopups[frame] = nil
    if frame and frame.Parent then frame.Visible = false end
end

function Library:CloseAllPopups()
    for popup, cb in pairs(self.ActivePopups) do
        if popup.Parent then
            popup.Visible = false
            if cb then cb() end
        end
    end
    self.ActivePopups = {}
end

--// Ripple Effect
function Library:Ripple(parent, x, y)
    task.spawn(function()
        local ripple = self:Create("Frame", {
            Parent = parent,
            BackgroundColor3 = Color3.new(1, 1, 1),
            BackgroundTransparency = 0.65,
            Position = UDim2.new(0, (x or parent.AbsoluteSize.X/2) - 5, 0, (y or parent.AbsoluteSize.Y/2) - 5),
            Size = UDim2.new(0, 10, 0, 10),
            ZIndex = parent.ZIndex + 20,
        })
        self:Create("UICorner", {Parent = ripple, CornerRadius = UDim.new(1, 0)})
        self:Tween(ripple, {
            Size = UDim2.new(0, 130, 0, 130),
            Position = UDim2.new(0, (x or parent.AbsoluteSize.X/2) - 65, 0, (y or parent.AbsoluteSize.Y/2) - 65),
            BackgroundTransparency = 1
        }, 0.55, Enum.EasingStyle.Quart)
        task.wait(0.55)
        if ripple then ripple:Destroy() end
    end)
end

--// Draggable (Mouse + Touch)
function Library:MakeDraggable(dragObj, moveObj)
    local dragging = false
    local startPos, dragStart

    dragObj.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = moveObj.Position
        end
    end)

    self:Connect(InputService.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            moveObj.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    self:Connect(InputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

--// Resizable (PC Exclusive)
function Library:MakeResizable(handle, target)
    if self.IsMobile then
        handle.Visible = false
        return
    end
    local resizing = false
    local startSize, startPos

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            resizing = true
            startSize = Vector2.new(target.AbsoluteSize.X, target.AbsoluteSize.Y)
            startPos = input.Position
        end
    end)

    self:Connect(InputService.InputChanged, function(input)
        if resizing and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - startPos
            local newW = math.clamp(startSize.X + delta.X, 600, 1150)
            local newH = math.clamp(startSize.Y + delta.Y, 420, 780)
            target.Size = UDim2.new(0, newW, 0, newH)
        end
    end)

    self:Connect(InputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            resizing = false
        end
    end)
end

--// Notification System
function Library:Notify(title, text, duration)
