            ZIndex = 1000,
        })
        self:Create("UIListLayout", {
            Parent = self.NotifContainer,
            VerticalAlignment = Enum.VerticalAlignment.Bottom,
            Padding = UDim.new(0, 12),
        })
        self:Create("UIPadding", {
            Parent = self.NotifContainer,
            PaddingBottom = UDim.new(0, 24),
            PaddingRight = UDim.new(0, 24),
        })
    end

    local Frame = self:Create("Frame", {
        Parent = self.NotifContainer,
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = self.Theme.Surface,
        BackgroundTransparency = 0.02,
        Position = UDim2.new(1, 50, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ClipsDescendants = true,
    })
    self:Create("UICorner", {Parent = Frame, CornerRadius = UDim.new(0, 12)})

    -- Animated gradient border
    local stroke = self:Create("UIStroke", {
        Parent = Frame,
        Color = Color3.new(1, 1, 1),
        Thickness = 1.5,
        Transparency = 0.25,
    })
    local grad = self:Create("UIGradient", {
        Parent = stroke,
        Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, self.Theme.Accent),
            ColorSequenceKeypoint.new(0.5, self.Theme.Accent2),
            ColorSequenceKeypoint.new(1, self.Theme.Accent),
        },
        Rotation = 0,
    })
    task.spawn(function()
        while Frame and Frame.Parent do
            grad.Rotation = (grad.Rotation + 1.2) % 360
            task.wait(0.03)
        end
    end)

    self:Create("UIPadding", {
        Parent = Frame,
        PaddingLeft = UDim.new(0, 18),
        PaddingRight = UDim.new(0, 18),
        PaddingTop = UDim.new(0, 14),
        PaddingBottom = UDim.new(0, 14),
    })

    local titleLbl = self:Create("TextLabel", {
        Parent = Frame,
        Text = title,
        Size = UDim2.new(1, 0, 0, 22),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 15,
        TextColor3 = self.Theme.Accent,
        TextXAlignment = Enum.TextXAlignment.Left,
        RichText = true,
    })

    local textLbl = self:Create("TextLabel", {
        Parent = Frame,
        Text = text,
        Size = UDim2.new(1, 0, 0, 0),
        Position = UDim2.new(0, 0, 0, 24),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextColor3 = self.Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        AutomaticSize = Enum.AutomaticSize.Y,
    })

    self:Tween(Frame, {Position = UDim2.new(0, 0, 0, 0)}, 0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

    task.delay(duration, function()
        self:Tween(Frame, {Position = UDim2.new(1, 60, 0, 0)}, 0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        task.wait(0.35)
        if Frame and Frame.Parent then Frame:Destroy() end
    end)
end

