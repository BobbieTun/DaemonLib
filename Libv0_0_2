end

-- Auto Cleanup
function Daemon:DestroyOldUI()
    pcall(function()
        if game.CoreGui then
            for _, gui in pairs(game.CoreGui:GetChildren()) do
                if gui:IsA("ScreenGui") and (gui.Name:match("^DaemonUI_") or gui.Name == "DaemonNotifications" or gui.Name == "DaemonKeySystem") then
                    pcall(function() gui:Destroy() end)
                end
            end
        end
    end)
    pcall(function()
        local player = Players.LocalPlayer
        if player and player:FindFirstChild("PlayerGui") then
            for _, gui in pairs(player.PlayerGui:GetChildren()) do
                if gui:IsA("ScreenGui") and (gui.Name:match("^DaemonUI_") or gui.Name == "DaemonNotifications" or gui.Name == "DaemonKeySystem") then
                    pcall(function() gui:Destroy() end)
                end
            end
        end
    end)
    self.NotificationGui = nil
    self.NotificationContainer = nil
end

