function Daemon:Notify(data)
    data = data or {}
    local title, content, duration, ntype, icon = data.Title or "Notification", data.Content or "", data.Duration or 5, data.Type or "Info", data.Icon or ""

    if not self.NotificationGui then
        self.NotificationGui = Create("ScreenGui", {Parent = game.CoreGui or LocalPlayer:WaitForChild("PlayerGui"), Name = "DaemonNotifications", ZIndexBehavior = Enum.ZIndexBehavior.Sibling, ResetOnSpawn = false})
        self.NotificationContainer = Create("Frame", {Parent = self.NotificationGui, Size = UDim2.new(0,350,1,-20), Position = UDim2.new(1,-370,0,10), BackgroundTransparency = 1})
        Create("UIListLayout", {Parent = self.NotificationContainer, Padding = UDim.new(0,10), HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Top, SortOrder = Enum.SortOrder.LayoutOrder})
    end

    local theme = self:GetTheme()
    local color = ntype == "Success" and theme.Success or ntype == "Warning" and theme.Warning or ntype == "Error" and theme.Error or theme.Accent

    local notif = Create("Frame", {Parent = self.NotificationContainer, Size = UDim2.new(0,350,0,0), BackgroundColor3 = theme.Surface, BackgroundTransparency = 0.1, BorderSizePixel = 0, ClipsDescendants = true})
    Create("UICorner", {CornerRadius = UDim.new(0,10), Parent = notif})
