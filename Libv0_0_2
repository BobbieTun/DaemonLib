            return d
        end

        return Tab
    end

    searchInput:GetPropertyChangedSignal("Text"):Connect(function()
        local q = searchInput.Text:lower()
        if currentTab then
            for _, child in pairs(currentTab:GetChildren()) do
                if child:IsA("GuiObject") and not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
                    local has = false
                    for _, d in pairs(child:GetDescendants()) do
                        if (d:IsA("TextLabel") or d:IsA("TextBox") or d:IsA("TextButton")) and d.Text:lower():find(q) then has = true break end
                    end
                    child.Visible = q == "" or has
                end
            end
        end
    end)

    return Window
end

-- Save Manager
Daemon.SaveManager = {Folder = "DaemonConfigs", Ignore = {}, Elements = {}}

function Daemon.SaveManager:SetFolder(f)
    self.Folder = f
    if not isfolder(f) then makefolder(f) end
end

function Daemon.SaveManager:IgnoreElement(flag)
    self.Ignore[flag] = true
end

function Daemon.SaveManager:RegisterElement(el, flag, typ)
    if not flag then return end
    self.Elements[flag] = {Element = el, Type = typ}
end

function Daemon.SaveManager:Save(name)
    name = name or "default"
    local data = {}
    for flag, info in pairs(self.Elements) do
        if not self.Ignore[flag] then
            local v = info.Element.Get()
            if info.Type == "ColorPicker" then data[flag] = {R = v.R * 255, G = v.G * 255, B = v.B * 255}
            else data[flag] = v end
        end
    end
    writefile(self.Folder .. "/" .. name .. ".json", HttpService:JSONEncode(data))
    Daemon:Notify({Title = "Config Saved", Content = "Saved to " .. name .. ".json", Type = "Success", Duration = 3})
end

function Daemon.SaveManager:Load(name)
    name = name or "default"
    local path = self.Folder .. "/" .. name .. ".json"
    if not isfile(path) then Daemon:Notify({Title = "Config Not Found", Content = "Could not find " .. name .. ".json", Type = "Error", Duration = 3}) return end
    local data = HttpService:JSONDecode(readfile(path))
    for flag, val in pairs(data) do
        local info = self.Elements[flag]
        if info then
            if info.Type == "ColorPicker" then pcall(function() info.Element.Set(Color3.fromRGB(val.R, val.G, val.B)) end)
            else pcall(function() info.Element.Set(val) end) end
        end
    end
    Daemon:Notify({Title = "Config Loaded", Content = "Loaded from " .. name .. ".json", Type = "Success", Duration = 3})
end

function Daemon.SaveManager:Delete(name)
    name = name or "default"
    local path = self.Folder .. "/" .. name .. ".json"
    if isfile(path) then delfile(path) Daemon:Notify({Title = "Config Deleted", Content = "Deleted " .. name .. ".json", Type = "Warning", Duration = 3}) end
end

function Daemon.SaveManager:GetConfigs()
    local c = {}
    if isfolder(self.Folder) then
        for _, f in pairs(listfiles(self.Folder)) do
            if f:match("%.json$") then table.insert(c, f:match("([^/\\]+)%.json$")) end
        end
    end
    return c
end

