    Drag(frame)

    local function validate(k)
        for _, vk in pairs(cfg.Keys or {}) do if k == vk then return true end end
        return false
    end

    submit.MouseButton1Click:Connect(function()
        if validate(input.Text) then
            Tween(frame, {Size = UDim2.new(0,0,0,0), Position = UDim2.new(0.5,0,0.5,0)}, 0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In, function() keyGui:Destroy() end)
            if cfg.Callback then cfg.Callback(true) end
        else
            status.Text = "Invalid key!"
            Tween(inputStroke, {Color = theme.Error}, 0.2)
            task.delay(1.5, function() status.Text = "" Tween(inputStroke, {Color = theme.Border}, 0.2) end)
