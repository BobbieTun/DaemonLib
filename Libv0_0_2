    Create("ImageLabel", {Parent = notif, Size = UDim2.new(1,20,1,20), Position = UDim2.new(0,-10,0,-10), BackgroundTransparency = 1, Image = "rbxassetid://5028857084", ImageColor3 = color, ImageTransparency = 0.9, ScaleType = Enum.ScaleType.Slice, SliceCenter = Rect.new(24,24,276,276), ZIndex = 0})
    Create("Frame", {Parent = notif, Size = UDim2.new(0,4,1,0), BackgroundColor3 = color, BorderSizePixel = 0})
    Create("ImageLabel", {Parent = notif, Size = UDim2.new(0,24,0,24), Position = UDim2.new(0,16,0,14), BackgroundTransparency = 1, Image = icon, ImageColor3 = color})
    Create("TextLabel", {Parent = notif, Size = UDim2.new(1,-60,0,22), Position = UDim2.new(0,48,0,12), BackgroundTransparency = 1, Text = title, TextColor3 = theme.TextPrimary, TextSize = 15, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left})

    local contentLabel = Create("TextLabel", {Parent = notif, Size = UDim2.new(1,-60,0,0), Position = UDim2.new(0,48,0,36), BackgroundTransparency = 1, Text = content, TextColor3 = theme.TextSecondary, TextSize = 13, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true})
    local closeBtn = Create("TextButton", {Parent = notif, Size = UDim2.new(0,24,0,24), Position = UDim2.new(1,-32,0,10), BackgroundTransparency = 1, Text = "×", TextColor3 = theme.TextSecondary, TextSize = 22, Font = Enum.Font.GothamBold})

    local h = math.max(70, contentLabel.TextBounds.Y + 50)
    notif.Size = UDim2.new(0,350,0,h)
    contentLabel.Size = UDim2.new(1,-60,0,contentLabel.TextBounds.Y)

    local progress = Create("Frame", {Parent = notif, Size = UDim2.new(1,0,0,2), Position = UDim2.new(0,0,1,-2), BackgroundColor3 = color, BorderSizePixel = 0, BackgroundTransparency = 0.3})

    notif.Position = UDim2.new(1,20,0,0)
    Tween(notif, {Position = UDim2.new(0,0,0,0)}, 0.4, Enum.EasingStyle.Back)
    Tween(progress, {Size = UDim2.new(0,0,0,2)}, duration)

    local function dismiss()
        Tween(notif, {Position = UDim2.new(1,50,0,0), BackgroundTransparency = 1}, 0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In, function() notif:Destroy() end)
    end
    closeBtn.MouseButton1Click:Connect(dismiss)
    task.delay(duration, dismiss)
end

