                    Position = UDim2.new(0.4, 4, 0, 0),
                    BackgroundColor3 = Library.Theme.Tertiary,
                    Text = "255, 255, 255",
                    TextColor3 = Library.Theme.Text,
                    Font = Enum.Font.Gotham,
                    TextSize = 12,
                    ClearTextOnFocus = false,
                    ZIndex = 5003,
