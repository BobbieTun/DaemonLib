                        BorderColor3 = Color3.new(0, 0, 0),
                        BorderSizePixel = 1,
                        ZIndex = 5003,
                    })
                end
                
                local function ClampToViewport(px, py, sx, sy)
                    local vp = Camera.ViewportSize
                    px = math.clamp(px, 8, vp.X - sx - 8)
                    py = math.clamp(py, 8, vp.Y - sy - 8)
                    return px, py
                end
                
                local function UpdatePopupPos(force)
                    if not Popup.Visible and not force then return end
                    local sx, sy = Popup.AbsoluteSize.X, Popup.AbsoluteSize.Y
                    local px = DisplayFrame.AbsolutePosition.X - sx + DisplayFrame.AbsoluteSize.X + 10
                    local py = DisplayFrame.AbsolutePosition.Y
                    px, py = ClampToViewport(px, py, sx, sy)
                    Popup.Position = UDim2.fromOffset(px, py)
                end
                
                function ColorPicker:Display()
                    ColorPicker.Value = Color3.fromHSV(ColorPicker.Hue, ColorPicker.Sat, ColorPicker.Vib)
                    
                    DisplayFrame.BackgroundColor3 = ColorPicker.Value
                    DisplayFrame.BackgroundTransparency = (Config.Transparency ~= nil) and ColorPicker.Transparency or 0
                    
                    SatVib.ImageColor3 = Color3.fromHSV(ColorPicker.Hue, 1, 1)
                    Cursor.Position = UDim2.new(ColorPicker.Sat, 0, 1 - ColorPicker.Vib, 0)
                    HueCursor.Position = UDim2.new(0.5, 0, ColorPicker.Hue, 0)
                    
                    HexBox.Text = "#" .. ColorPicker.Value:ToHex()
                    RgbBox.Text = string.format("%d, %d, %d",
                        math.floor(ColorPicker.Value.R * 255),
                        math.floor(ColorPicker.Value.G * 255),
                        math.floor(ColorPicker.Value.B * 255))
                    
                    if TransparencyBar then
                        TransparencyBar.ImageColor3 = ColorPicker.Value
                        TransCursor.Position = UDim2.new(1 - ColorPicker.Transparency, 0, 0, 0)
                    end
                    
                    local flagName = Config.Flag or Config.Name
                    if Config.Transparency ~= nil then
                        Library.Flags[flagName] = {Color = ColorPicker.Value, Transparency = ColorPicker.Transparency}
                    else
                        Library.Flags[flagName] = ColorPicker.Value
                    end
                    
                    local success, err = pcall(ColorPicker.Callback, ColorPicker.Value, ColorPicker.Transparency)
                    if not success then warn("DaemonIX ColorPicker Error: " .. tostring(err)) end
                end
                
                local draggingHue, draggingSat, draggingTrans = false, false, false
                
                local function UpdateHue(input)
                    local y = math.clamp(input.Position.Y - HueBar.AbsolutePosition.Y, 0, HueBar.AbsoluteSize.Y)
                    ColorPicker.Hue = y / HueBar.AbsoluteSize.Y
                    ColorPicker:Display()
                end
                
                local function UpdateSatVib(input)
                    local x = math.clamp(input.Position.X - SatVib.AbsolutePosition.X, 0, SatVib.AbsoluteSize.X)
                    local y = math.clamp(input.Position.Y - SatVib.AbsolutePosition.Y, 0, SatVib.AbsoluteSize.Y)
                    ColorPicker.Sat = x / SatVib.AbsoluteSize.X
                    ColorPicker.Vib = 1 - (y / SatVib.AbsoluteSize.Y)
                    ColorPicker:Display()
                end
                
                local function UpdateTrans(input)
                    if not TransparencyBar then return end
                    local x = math.clamp(input.Position.X - TransparencyBar.AbsolutePosition.X, 0, TransparencyBar.AbsoluteSize.X)
                    ColorPicker.Transparency = 1 - (x / TransparencyBar.AbsoluteSize.X)
                    ColorPicker:Display()
                end
                
                HueBar.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or 
                       input.UserInputType == Enum.UserInputType.Touch then
                        draggingHue = true
                        UpdateHue(input)
                    end
                end)
                
                SatVib.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or 
                       input.UserInputType == Enum.UserInputType.Touch then
                        draggingSat = true
                        UpdateSatVib(input)
                    end
                end)
                
                if TransparencyBar then
                    TransparencyBar.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or 
                           input.UserInputType == Enum.UserInputType.Touch then
                            draggingTrans = true
                            UpdateTrans(input)
                        end
                    end)
                end
                
                Library:Connect(InputService.InputChanged, function(input)
                    local t = input.UserInputType
                    if t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch then
                        if draggingHue then UpdateHue(input) end
                        if draggingSat then UpdateSatVib(input) end
                        if draggingTrans then UpdateTrans(input) end
                    end
                end)
                
                Library:Connect(InputService.InputEnded, function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or 
                       input.UserInputType == Enum.UserInputType.Touch then
                        draggingHue, draggingSat, draggingTrans = false, false, false
                    end
                end)
                
                DisplayFrame.MouseButton1Click:Connect(function()
                    if Popup.Visible then
                        Library:ClosePopup(Popup)
                    else
                        Library:RegisterPopup(Popup, nil)
                        UpdatePopupPos(true)
                    end
                end)
                
                DisplayFrame.MouseButton2Click:Connect(function()
                    ColorPicker.Rainbow = not ColorPicker.Rainbow
                    Library:Notify("Rainbow Mode", "Toggled: " .. tostring(ColorPicker.Rainbow), 2)
                end)
                
                Library:Connect(RunService.RenderStepped, function()
                    if Popup and Popup.Parent and Popup.Visible then
                        UpdatePopupPos()
                    end
                end)
                
                task.spawn(function()
                    while Popup and Popup.Parent do
                        if ColorPicker.Rainbow then
                            ColorPicker.Hue = (tick() % 5) / 5
                            ColorPicker:Display()
                        end
                        task.wait()
                    end
                end)
                
                HexBox.FocusLost:Connect(function()
                    local txt = HexBox.Text:gsub("#", "")
                    if #txt == 6 then
                        local ok, col = pcall(Color3.fromHex, txt)
                        if ok and col then
                            SetHSVFromRGB(col)
                            ColorPicker:Display()
                        end
                    end
                end)
                
                RgbBox.FocusLost:Connect(function()
                    local r, g, b = RgbBox.Text:match("(%d+)%s*,%s*(%d+)%s*,%s*(%d+)")
                    r, g, b = tonumber(r), tonumber(g), tonumber(b)
                    if r and g and b then
                        r = math.clamp(r, 0, 255)
                        g = math.clamp(g, 0, 255)
                        b = math.clamp(b, 0, 255)
                        SetHSVFromRGB(Color3.fromRGB(r, g, b))
                        ColorPicker:Display()
                    end
                end)
                
                ColorPicker:Display()
                return ColorPicker
            end
            
            return Section
        end
        
        return Tab
    end
    
    --// Global Input Handlers (per window instance)
    Library:Connect(InputService.InputBegan, function(input, processed)
        if input.KeyCode == Library.Keybind and not processed then
            Library.IsVisible = not Library.IsVisible
            if Library.ScreenGui then
                Library.ScreenGui.Enabled = Library.IsVisible
            end
        end
    end)
    
    Library:Connect(InputService.InputBegan, function(input, processed)
        if processed then return end
        for _, bind in pairs(Library.Toggles) do
            if bind.Value and input.KeyCode == bind.Value then
                if bind.Mode == "Toggle" then
                    bind.State = not bind.State
                    if bind.Callback then pcall(bind.Callback, bind.State) end
                elseif bind.Mode == "Hold" then
                    bind.State = true
                    if bind.Callback then pcall(bind.Callback, true) end
                end
            end
        end
    end)
    
    Library:Connect(InputService.InputEnded, function(input)
        for _, bind in pairs(Library.Toggles) do
            if bind.Value and bind.Mode == "Hold" and input.KeyCode == bind.Value then
                bind.State = false
                if bind.Callback then pcall(bind.Callback, false) end
            end
        end
    end)
    
    --// Popup outside-click handler
    Library:Connect(InputService.InputBegan, function(input, processed)
        if processed then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and 
           input.UserInputType ~= Enum.UserInputType.Touch then return end
        
        local pos = input.Position
        local toClose = {}
        for popup, cb in pairs(Library.ActivePopups) do
            if popup.Visible and popup.Parent then
                local absPos = popup.AbsolutePosition
                local absSize = popup.AbsoluteSize
                if pos.X < absPos.X or pos.X > absPos.X + absSize.X or
                   pos.Y < absPos.Y or pos.Y > absPos.Y + absSize.Y then
                    table.insert(toClose, popup)
                end
            end
        end
        for _, popup in ipairs(toClose) do
            Library:ClosePopup(popup)
        end
    end)
    
    Library:Connect(InputService.InputBegan, function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.Escape then
            Library:CloseAllPopups()
        end
    end)
    
    --// Config
    function Library:SaveConfig(name)
        local ok, err = pcall(function()
            if not isfolder(self.Directory) then makefolder(self.Directory) end
        end)
        if not ok then
            self:Notify("Config Error", "Cannot access filesystem", 3)
            return
        end
        
        local sanitized = {}
        for k, v in pairs(self.Flags) do
            if typeof(v) == "Color3" then
                sanitized[k] = {__Type = "Color3", R = v.R, G = v.G, B = v.B}
            elseif typeof(v) == "EnumItem" then
                sanitized[k] = {__Type = "Enum", Class = tostring(v.EnumType), Value = v.Name}
            elseif typeof(v) == "table" and v.Color and typeof(v.Color) == "Color3" then
                sanitized[k] = {
                    __Type = "ColorTrans",
                    R = v.Color.R, G = v.Color.G, B = v.Color.B,
                    Transparency = v.Transparency
                }
            else
                sanitized[k] = v
            end
        end
        
        local json = HttpService:JSONEncode(sanitized)
        writefile(self.Directory .. "/" .. name .. ".json", json)
        self:Notify("Config", "Saved config: " .. name, 3)
    end
    
    function Library:LoadConfig(name)
        local ok, err = pcall(function()
            return isfile(self.Directory .. "/" .. name .. ".json")
        end)
        if not ok or not err then
            self:Notify("Config Error", "Config not found: " .. name, 3)
            return
        end
        
        local json = readfile(self.Directory .. "/" .. name .. ".json")
        local data = HttpService:JSONDecode(json)
        
        for k, v in pairs(data) do
            if type(v) == "table" and v.__Type then
                if v.__Type == "Color3" then
                    self.Flags[k] = Color3.new(v.R, v.G, v.B)
                elseif v.__Type == "Enum" then
                    local enumType = Enum[v.Class]
                    if enumType then
                        self.Flags[k] = enumType[v.Value]
                    end
                elseif v.__Type == "ColorTrans" then
                    self.Flags[k] = {Color = Color3.new(v.R, v.G, v.B), Transparency = v.Transparency}
                end
            else
                self.Flags[k] = v
            end
        end
        self:Notify("Config", "Loaded config: " .. name, 3)
    end
    
    function Library:Unload()
        self:DisconnectAll()
        if self.ScreenGui then
            self.ScreenGui:Destroy()
        end
        self.ScreenGui = nil
        self.NotifContainer = nil
    end
    
    return self
end

