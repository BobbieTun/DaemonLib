--// Utility
local function Create(className, properties, children)
    local instance = Instance.new(className)
    if properties then
        for prop, value in pairs(properties) do
            instance[prop] = value
        end
    end
    if children then
        for _, child in pairs(children) do
            child.Parent = instance
        end
    end
    return instance
end

local function Tween(instance, properties, duration, easingStyle, easingDirection, callback)
    local tween = TweenService:Create(
        instance,
        TweenInfo.new(duration or 0.3, easingStyle or Enum.EasingStyle.Quart, easingDirection or Enum.EasingDirection.Out),
        properties
    )
    if callback then tween.Completed:Connect(callback) end
    tween:Play()
    return tween
end

local function ApplyGlow(frame, color, thickness)
    local stroke = Create("UIStroke", {
        Color = color,
        Thickness = thickness or 1.2,
        Transparency = 0.5,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Name = "GlowInner",
    })
    stroke.Parent = frame
    local outer = Create("UIStroke", {
        Color = color,
        Thickness = (thickness or 1.2) * 2.5,
        Transparency = 0.92,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Name = "GlowOuter",
    })
    outer.Parent = frame
    return stroke, outer
end

--// Main Library
DaemonUI.Version = "2.1.1"
DaemonUI.Theme = "PurpleNeon"
DaemonUI.Window = nil
DaemonUI.GUI = nil
DaemonUI.OverlayLayer = nil
DaemonUI.Registry = {} -- Store all themed elements for dynamic updates
DaemonUI.ActiveDropdown = nil -- Track currently opened dropdown

function DaemonUI:Register(obj)
    table.insert(self.Registry, obj)
end

function DaemonUI:SetTheme(themeName)
    if Themes[themeName] then
        self.Theme = themeName
        self:UpdateTheme()
    end
end

function DaemonUI:GetTheme()
    return Themes[self.Theme]
end

function DaemonUI:UpdateTheme()
    local t = self:GetTheme()
    -- Update window frame
    if self.Window then
        local w = self.Window
        Tween(w.Frame, {BackgroundColor3 = t.Background}, 0.3)
        Tween(w.TabHolder, {BackgroundColor3 = t.BackgroundSecondary}, 0.3)
        Tween(w.ContentHolder, {BackgroundColor3 = t.BackgroundSecondary}, 0.3)
        if w.TitleBar then
            Tween(w.TitleBar, {BackgroundColor3 = t.TitleBar}, 0.3)
        end
        if w.TopLine then
            w.TopLine.BackgroundColor3 = t.Border
        end
        if w.Shadow then
            -- Shadow stays black
        end
    end
    -- Update all registered elements
    for _, obj in ipairs(self.Registry) do
        if obj._UpdateTheme then
            pcall(function() obj:_UpdateTheme() end)
        end
    end
end

--// Global dropdown closer (single connection, no leak)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
    if gameProcessed then return end
    if not DaemonUI.ActiveDropdown then return end
    
    local dd = DaemonUI.ActiveDropdown
    local mousePos = UserInputService:GetMouseLocation()
    local ddPos = dd.Menu.AbsolutePosition
    local ddSize = dd.Menu.AbsoluteSize
    local btnPos = dd.Button.AbsolutePosition
    local btnSize = dd.Button.AbsoluteSize
    
    local inMenu = mousePos.X >= ddPos.X and mousePos.X <= ddPos.X + ddSize.X and mousePos.Y >= ddPos.Y and mousePos.Y <= ddPos.Y + ddSize.Y
    local inBtn = mousePos.X >= btnPos.X and mousePos.X <= btnPos.X + btnSize.X and mousePos.Y >= btnPos.Y and mousePos.Y <= btnPos.Y + btnSize.Y
    
    if not inMenu and not inBtn then
        dd:Close()
    end
end)

