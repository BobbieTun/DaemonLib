                        end)
                        Tween(arrow, {Rotation = 0}, 0.2)
                    end,
                    Set = function(self, newValue)
                        if config.Values and table.find(config.Values, newValue) then
                            selected = newValue; ddBtn.Text = newValue
                            if config.Callback then config.Callback(newValue) end
                        end
                    end,
                    Get = function(self) return selected end,
                    Refresh = function(self, newValues)
