                        Tween(dropdownMenu, {Size = UDim2.new(0, dropdownMenu.AbsoluteSize.X > 0 and dropdownMenu.AbsoluteSize.X or ddBtn.AbsoluteSize.X, 0, height)}, 0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
