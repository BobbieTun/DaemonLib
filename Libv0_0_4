                    dropdownMenu.Position = UDim2.new(0, absPos.X, 0, absPos.Y + absSize.Y + 4)
                    dropdownMenu.Size = UDim2.new(0, absSize.X, 0, 0)
                end

                local function buildOptions()
                    -- Clear old
                    for _, btn in ipairs(optionButtons) do
                        btn:Destroy()
                    end
                    optionButtons = {}
                    if not config.Values then return end
                    local ct = DaemonUI:GetTheme()
                    dropdownMenu.BackgroundColor3 = ct.Dropdown
                    ddglow1.Color = ct.Glow; ddglow2.Color = ct.Glow
                    for _, val in pairs(config.Values) do
                        local opt = Create("TextButton", {
